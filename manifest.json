{
  "manifest_version": 3,
  "name": "CustomTab",
  "version": "1.0",
  "description": "Sürükle-bırak destekli sekme sayfası.",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["back.jpg", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
